#!/command/with-contenv bash
set -Eeuo pipefail

DSH_HOME="${DSH_HOME:-/data/dsh}"
mkdir -p "$DSH_HOME" /workspace

# s6 v3 runs services from a temporary directory, so pin the working directory.
cd /workspace

# DSH refuses wildcard binds; pass one concrete container IPv4 address.
ip="$(node -e '
  const os = require("node:os")
  for (const [name, addrs] of Object.entries(os.networkInterfaces())) {
    if (name === "lo") continue
    const a = (addrs || []).find(i => !i.internal && i.family === "IPv4")
    if (a) { process.stdout.write(a.address); process.exit(0) }
  }
  process.exit(1)
')"

# DSH only accepts loopback, its own bind IP, or an explicitly trusted authority.
# Reaching the UI by the host's LAN IP or a domain therefore needs
# --trusted-host for each of them, otherwise every /api call returns 403.
args=(web --no-open --host "$ip" --port 3080)
if [[ -n "${DSH_TRUSTED_HOSTS:-}" ]]; then
  IFS=',' read -r -a hosts <<< "$DSH_TRUSTED_HOSTS"
  for h in "${hosts[@]}"; do
    h="${h//[[:space:]]/}"
    [[ -n "$h" ]] && args+=(--trusted-host "$h")
  done
fi

exec dsh "${args[@]}"
