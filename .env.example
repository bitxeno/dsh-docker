DSH_PORT=3080
DEEPSEEK_API_KEY=
TZ=Asia/Shanghai

# Authorities allowed to open the UI besides loopback.
# Use the exact host you type in the browser (host or host:port).
# Accessing by LAN IP or a domain without this returns 403 on /api calls.
DSH_TRUSTED_HOSTS=192.168.1.1

# Optional bind address inside the container's network namespace. Leave unset
# to auto-detect the container's first non-loopback IPv4 (what bridge + ports
# DNAT reaches). Only set it to choose a specific *container* interface; the
# host's LAN IP (e.g. 192.168.1.1) is not a container address and is ignored.
# DSH_BIND_IP=172.18.0.2
