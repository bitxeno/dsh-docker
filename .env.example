DSH_PORT=3080
DEEPSEEK_API_KEY=
TZ=Asia/Shanghai

# Authorities allowed to open the UI besides loopback.
# Use the exact host you type in the browser (host or host:port).
# Accessing by LAN IP or a domain without this returns 403 on /api calls.
DSH_TRUSTED_HOSTS=192.168.1.1

# Optional concrete bind address for `dsh web`. Leave unset to keep dsh's
# loopback default (use with network_mode: host). With bridge + ports, set it
# to the container interface IP or DNAT traffic misses the loopback listener.
# DSH_BIND_IP=172.18.0.2
