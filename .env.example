DSH_PORT=3080
DEEPSEEK_API_KEY=
TZ=Asia/Shanghai

# Authorities allowed to open the UI besides loopback.
# List the exact host used in the browser, e.g. your reverse-proxy domain.
# Missing entries here make /api return 403 (the host check runs before auth).
DSH_TRUSTED_HOSTS=ai.lan

# Loopback bind (default). Keep this unless you switch to bridge networking,
# where you must set it to the container interface IP instead.
# DSH_BIND_IP=127.0.0.1
